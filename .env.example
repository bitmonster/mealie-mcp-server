# Copy values into your MCP client's environment configuration.
# Do not commit a populated .env file.
MEALIE_BASE_URL=http://127.0.0.1:9000
MEALIE_PUBLIC_URL=http://127.0.0.1:9000
MEALIE_API_TOKEN=[REDACTED]

# Safe defaults: mutations disabled and fail-closed scope.
MEALIE_MCP_ALLOW_MUTATIONS=false
MEALIE_MCP_MUTATION_SCOPE=none
MEALIE_MCP_ALLOW_URL_IMPORTS=false
MEALIE_MCP_ALLOW_REMOTE_SOURCES=false

# Optional runtime controls
MEALIE_MCP_TIMEOUT=30
MEALIE_MCP_DATA_DIR=~/.cache/mealie-mcp
# MEALIE_MCP_DOWNLOAD_DIR=~/.cache/mealie-mcp/downloads
# MEALIE_MCP_ALLOWED_LOCAL_ROOTS=/absolute/import/path
# MEALIE_MCP_MAX_DOWNLOAD_BYTES=104857600
# MEALIE_MCP_MAX_JSON_BYTES=10485760
# MEALIE_MCP_MAX_OPENAPI_BYTES=20971520
# MEALIE_MCP_MAX_IMAGE_PIXELS=40000000
# MEALIE_MCP_OCR_TIMEOUT=60
